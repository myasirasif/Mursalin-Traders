{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mursalin-traders-alpha.vercel.app" }],
      "destination": "https://www.mursalintraders.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
